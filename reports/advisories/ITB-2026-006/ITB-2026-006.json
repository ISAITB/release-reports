      "cwes": [
        379
      ],
      "description": "The GITB Test Bed software and standalone validators use in certain occasions the OS temporary folder to store temporary files. The OS temporary folder is typically accessible to non-application OS users and can be accessed to reveal unintended data.",
      "detail": "Use of the OS temporary folder occurs in certain processing paths in all standalone validators (XML, JSON, SHACL and CSV), as well as the GITB Test Bed software. The data written here is not sensitive in nature but it is not intended to be shared with users having access to the OS temporary folder.",
      "recommendation": "For the standalone XML, JSON, CSV and SHACL validators upgrade to release 1.13.1 or later.\nFor the GITB Test Bed software upgrade to release 1.30.2 or later.\n\nAs of these releases, all temporary processing files are stored in specific application-owned folders.",
      "advisories": [
        {
          "url": "https://cwe.mitre.org/data/definitions/379.html"
        }
      ],
      "created": "2026-11-13T00:00:00Z",
      "published": "2026-11-13T00:00:00Z",
      "properties": [
        {
          "name": "title",
          "value": "Use of the operating system temporary folder for intermediate processing"
        }
      ],
